        {"2628997c9ec9f5cb5502298d06576336c85b9de08d9ed4ccd068ec2cb5ee3bf3":"敵全体に毒付与（毎秒【弱体】数×900ダメージ）","5b5e79a84743e7bd82981705a49b0786f46624171354c91c89f717616e27be12":32003,"c807aef88c2571044d5a76ea9639bed74b6f8220ab0ad862fd2203729ecee83a":32003,"5515f4ace45482af8748cdfead5c1a370ee8b51615adf98656853b5ab631b5e7":3,"cfb3396407224e55f8d9dae6ceaa9ceb4fe021ee51aed3c7130badb0631414e5":3,"5c529b8f21ee197d700601b7534a66c33e329f373ff5c4f03d6a538e412d0e02":"滅刻凶刃ヴェノマス","dcd1468f0731046612a8421f55aaec5e4bb664f5c2cc9f1f7c02afdbc1f181a2":2,"a6512821f224154e01cbbd3bdf845777d6e914cdce3c266d1198b38a03fefe6d":"不思議な効果を持つ、黒刃の刺剣\\n刃に埋め込まれた宝玉が、絶え間\\nなく邪毒を撒き散らし、破滅へと\\n刻々と時を数える。"},
        {"2628997c9ec9f5cb5502298d06576336c85b9de08d9ed4ccd068ec2cb5ee3bf3":"敵の物理/魔法攻撃力－20％","5b5e79a84743e7bd82981705a49b0786f46624171354c91c89f717616e27be12":32004,"c807aef88c2571044d5a76ea9639bed74b6f8220ab0ad862fd2203729ecee83a":32004,"5515f4ace45482af8748cdfead5c1a370ee8b51615adf98656853b5ab631b5e7":3,"cfb3396407224e55f8d9dae6ceaa9ceb4fe021ee51aed3c7130badb0631414e5":3,"5c529b8f21ee197d700601b7534a66c33e329f373ff5c4f03d6a538e412d0e02":"燦然御纏アノラ・ベイラ","dcd1468f0731046612a8421f55aaec5e4bb664f5c2cc9f1f7c02afdbc1f181a2":2,"a6512821f224154e01cbbd3bdf845777d6e914cdce3c266d1198b38a03fefe6d":"不思議な効果を持つ、宝飾をあし\\nらったベール。蔽布の下から滲み\\n出るオーラが、相手の敵意を解き\\nほぐし、無力化させてしまう。"},
        {"2628997c9ec9f5cb5502298d06576336c85b9de08d9ed4ccd068ec2cb5ee3bf3":"敵の物理/魔法防御力－20％","5b5e79a84743e7bd82981705a49b0786f46624171354c91c89f717616e27be12":32005,"c807aef88c2571044d5a76ea9639bed74b6f8220ab0ad862fd2203729ecee83a":32005,"5515f4ace45482af8748cdfead5c1a370ee8b51615adf98656853b5ab631b5e7":3,"cfb3396407224e55f8d9dae6ceaa9ceb4fe021ee51aed3c7130badb0631414e5":3,"5c529b8f21ee197d700601b7534a66c33e329f373ff5c4f03d6a538e412d0e02":"断壁鎖刃フラグメント","dcd1468f0731046612a8421f55aaec5e4bb664f5c2cc9f1f7c02afdbc1f181a2":2,"a6512821f224154e01cbbd3bdf845777d6e914cdce3c266d1198b38a03fefe6d":"不思議な効果を持つ、⼑⾝に鎖を\\n這わせた妖⼑。主の意思に逆らい\\n暴れる鎖が怨敵の守りを打ち崩し\\n紫黒の凶刃が悉くを断ち斬る。"},
        {"2628997c9ec9f5cb5502298d06576336c85b9de08d9ed4ccd068ec2cb5ee3bf3":"敵の物理/魔法被クリダメ＋30％","5b5e79a84743e7bd82981705a49b0786f46624171354c91c89f717616e27be12":33001,"c807aef88c2571044d5a76ea9639bed74b6f8220ab0ad862fd2203729ecee83a":33001,"5515f4ace45482af8748cdfead5c1a370ee8b51615adf98656853b5ab631b5e7":3,"cfb3396407224e55f8d9dae6ceaa9ceb4fe021ee51aed3c7130badb0631414e5":3,"5c529b8f21ee197d700601b7534a66c33e329f373ff5c4f03d6a538e412d0e02":"リーサルハルバード","dcd1468f0731046612a8421f55aaec5e4bb664f5c2cc9f1f7c02afdbc1f181a2":3,"a6512821f224154e01cbbd3bdf845777d6e914cdce3c266d1198b38a03fefe6d":"不思議な効果を持つ、地神の力を\\n宿した烈槍。大地の力を糧に放つ\\n無比の一閃は、地に立つすべての\\n敵に甚大なダメージを与える。"},
        {"2628997c9ec9f5cb5502298d06576336c85b9de08d9ed4ccd068ec2cb5ee3bf3":"物理/魔法クリダメ＋30％","5b5e79a84743e7bd82981705a49b0786f46624171354c91c89f717616e27be12":33002,"c807aef88c2571044d5a76ea9639bed74b6f8220ab0ad862fd2203729ecee83a":33002,"5515f4ace45482af8748cdfead5c1a370ee8b51615adf98656853b5ab631b5e7":3,"cfb3396407224e55f8d9dae6ceaa9ceb4fe021ee51aed3c7130badb0631414e5":3,"5c529b8f21ee197d700601b7534a66c33e329f373ff5c4f03d6a538e412d0e02":"オオトリノカタナ","dcd1468f0731046612a8421f55aaec5e4bb664f5c2cc9f1f7c02afdbc1f181a2":3,"a6512821f224154e01cbbd3bdf845777d6e914cdce3c266d1198b38a03fefe6d":"不思議な効果を持つ、伝説に語ら\\nれる極みの一振り。鳳凰の力を宿\\nした真紅の刃は、焔の如き赫く激\\n烈な一撃を与える。"},
        {"2628997c9ec9f5cb5502298d06576336c85b9de08d9ed4ccd068ec2cb5ee3bf3":"通常攻撃強化＋90","5b5e79a84743e7bd82981705a49b0786f46624171354c91c89f717616e27be12":33003,"c807aef88c2571044d5a76ea9639bed74b6f8220ab0ad862fd2203729ecee83a":33003,"5515f4ace45482af8748cdfead5c1a370ee8b51615adf98656853b5ab631b5e7":3,"cfb3396407224e55f8d9dae6ceaa9ceb4fe021ee51aed3c7130badb0631414e5":3,"5c529b8f21ee197d700601b7534a66c33e329f373ff5c4f03d6a538e412d0e02":"アースデストラクション","dcd1468f0731046612a8421f55aaec5e4bb664f5c2cc9f1f7c02afdbc1f181a2":3,"a6512821f224154e01cbbd3bdf845777d6e914cdce3c266d1198b38a03fefe6d":"不思議な効果を持つ、地核のエネ\\nルギーを封じた籠手。振るう一撃\\nは、世界を破壊するかの如く、通\\n常攻撃を大きく強化する。"},
